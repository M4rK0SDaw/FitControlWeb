@model FitControlWeb.ViewModels.SuscripcionCreateViewModel

@{
    ViewData["Title"] = "Nueva suscripcion";
    var tipos = Model.TiposSuscripcionData;
    var clienteSeleccionado = Model.Usuarios.FirstOrDefault(u => u.Value == Model.UsuarioId.ToString())?.Text ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/CrudStyle.css" asp-append-version="true" />
}

<div class="page-card">
    <div class="page-header">
        <div>
            <h2 class="page-title">Nueva suscripcion</h2>
            <p class="text-muted mb-0">Crear una suscripcion para un cliente</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" data-fit-validation-toast="true"></div>
        }

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="info-box">
                    <h5 class="fw-bold mb-3">Datos de suscripcion</h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="UsuarioId" class="form-label">Cliente</label>
                            <input type="text"
                                   id="usuarioSearch"
                                   class="form-control"
                                   placeholder="Escribe nombre o email del cliente..."
                                   autocomplete="off"
                                   list="usuariosDatalist"
                                   value="@clienteSeleccionado" />
                            <input asp-for="UsuarioId" type="hidden" id="usuarioId" />
                            <datalist id="usuariosDatalist">
                                @foreach (var usuario in Model.Usuarios)
                                {
                                    <option value="@usuario.Text" data-id="@usuario.Value"></option>
                                }
                            </datalist>
                            <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TipoSuscripcionId" class="form-label">Tipo</label>

                            <select asp-for="TipoSuscripcionId" class="form-select" id="tipoSuscripcion">
                                <option value="">Selecciona tipo</option>

                                @foreach (var tipo in tipos)
                                {
                                    <option value="@tipo.Id"
                                            data-duracion="@tipo.DuracionDias"
                                            data-precio="@tipo.Precio.ToString("0.00")">
                                        @tipo.Nombre - @tipo.Precio.ToString("0.00") EUR - @tipo.DuracionDias dias
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="TipoSuscripcionId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaInicio" class="form-label">Fecha inicio</label>
                            <input asp-for="FechaInicio" type="date" class="form-control" id="fechaInicio" />
                            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Fecha fin calculada</label>
                            <input type="date" class="form-control" id="fechaFinVisual" readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Precio</label>
                            <input type="text" class="form-control" id="precioVisual" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>

            <button type="submit" class="btn btn-orange">
                <i class="bi bi-save me-1"></i> Guardar suscripcion
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function calcularDatosSuscripcion() {
            const tipoSelect = document.getElementById("tipoSuscripcion");
            const fechaInicioInput = document.getElementById("fechaInicio");
            const fechaFinInput = document.getElementById("fechaFinVisual");
            const precioInput = document.getElementById("precioVisual");

            const selectedOption = tipoSelect.options[tipoSelect.selectedIndex];
            const duracion = parseInt(selectedOption?.dataset?.duracion || "0");
            const precio = selectedOption?.dataset?.precio || "";

            precioInput.value = precio ? precio + " EUR" : "";

            if (!fechaInicioInput.value || duracion <= 0) {
                fechaFinInput.value = "";
                return;
            }

            const fecha = new Date(fechaInicioInput.value);
            fecha.setDate(fecha.getDate() + duracion);
            fechaFinInput.value = fecha.toISOString().split("T")[0];
        }

        document.getElementById("tipoSuscripcion").addEventListener("change", calcularDatosSuscripcion);
        document.getElementById("fechaInicio").addEventListener("change", calcularDatosSuscripcion);

        const usuarioSearchInput = document.getElementById("usuarioSearch");
        const usuarioIdInput = document.getElementById("usuarioId");
        const usuarioOptions = Array.from(document.querySelectorAll("#usuariosDatalist option"));

        function sincronizarClienteSeleccionado() {
            const texto = usuarioSearchInput.value.trim().toLowerCase();
            const match = usuarioOptions.find(option => option.value.trim().toLowerCase() === texto);
            usuarioIdInput.value = match?.dataset?.id || "";
        }

        usuarioSearchInput.addEventListener("input", sincronizarClienteSeleccionado);
        usuarioSearchInput.addEventListener("change", sincronizarClienteSeleccionado);
        usuarioSearchInput.addEventListener("blur", sincronizarClienteSeleccionado);

        sincronizarClienteSeleccionado();
        calcularDatosSuscripcion();
    </script>
}

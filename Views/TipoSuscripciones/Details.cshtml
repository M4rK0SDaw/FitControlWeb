@model FitControlWeb.Models.Entities.TipoSuscripcion

@{
    ViewData["Title"] = "Detalle tipo de suscripción";
    var suscripciones = Model.Suscripcions?
        .OrderByDescending(s => s.FechaInicio)
        .ToList() ?? new List<FitControlWeb.Models.Entities.Suscripcion>();
    var facturasPorSuscripcion = ViewBag.FacturasPorSuscripcion as Dictionary<int, FitControlWeb.Models.Entities.Factura>
        ?? new Dictionary<int, FitControlWeb.Models.Entities.Factura>();
    var hoy = DateTime.Today;
    var activas = suscripciones.Count(s => s.Activa == true && s.FechaFin >= hoy);
    var inactivas = suscripciones.Count - activas;
}

@section Styles {
    <link rel="stylesheet" href="~/css/CrudStyle.css" asp-append-version="true" />
}

<div class="page-card">
    <div class="page-header flex-wrap gap-3">
        <div>
            <h2 class="page-title">@Model.Nombre</h2>
            <p class="text-muted mb-0">Información completa del tipo de suscripción</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-orange">
                <i class="bi bi-pencil"></i> Editar
            </a>

            @if (Model.Activo == true)
            {
                <form asp-action="Desactivar"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline form-desactivar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", "TipoSuscripciones")" />

                    <button type="button" class="btn btn-outline-danger btn-desactivar">
                        <i class="bi bi-x-circle"></i> Desactivar
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Activar"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline form-activar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                    <button type="button" class="btn btn-outline-success btn-activar">
                        <i class="bi bi-arrow-clockwise"></i> Activar
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="info-box">
        <h5 class="fw-bold mb-3">Datos</h5>

        <div class="row g-3">
            <div class="col-md-3">
                <span class="info-label">Nombre</span>
                <p class="info-value">@Model.Nombre</p>
            </div>

            <div class="col-md-3">
                <span class="info-label">Precio</span>
                <p class="info-value">@Model.Precio.ToString("0.00") €</p>
            </div>

            <div class="col-md-3">
                <span class="info-label">Duración</span>
                <p class="info-value">@Model.DuracionDias días</p>
            </div>

            <div class="col-md-3">
                <span class="info-label">Estado</span>
                <br />
                <span class="badge @(Model.Activo == true ? "bg-success" : "bg-danger")">
                    @(Model.Activo == true ? "Activo" : "Inactivo")
                </span>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-4">
        <div class="col-md-4">
            <div class="info-box">
                <span class="info-label">Total suscripciones</span>
                <p class="info-value mb-0">@suscripciones.Count</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box">
                <span class="info-label">Activas</span>
                <p class="info-value mb-0">@activas</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box">
                <span class="info-label">Caducadas o inactivas</span>
                <p class="info-value mb-0">@inactivas</p>
            </div>
        </div>
    </div>

    <div class="info-box mt-4">
        <h5 class="fw-bold mb-3">Usuarios suscritos</h5>

        @if (!suscripciones.Any())
        {
            <div class="alert alert-info mb-0">
                No hay usuarios suscritos a este tipo de suscripción.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-modern align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Usuario</th>
                            <th>Email</th>
                            <th>Fecha inicio</th>
                            <th>Fecha fin</th>
                            <th>Estado</th>
                            <th>Factura</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var suscripcion in suscripciones)
                        {
                            var activa = suscripcion.Activa == true && suscripcion.FechaFin >= hoy;
                            facturasPorSuscripcion.TryGetValue(suscripcion.Id, out var factura);

                            <tr>
                                <td>
                                    @if (suscripcion.Usuario != null)
                                    {
                                        <a asp-controller="Usuarios"
                                           asp-action="Details"
                                           asp-route-id="@suscripcion.Usuario.Id"
                                           class="fw-semibold">
                                            @suscripcion.Usuario.Nombre @suscripcion.Usuario.Apellidos
                                        </a>
                                    }
                                    else
                                    {
                                        <span>Sin usuario</span>
                                    }
                                </td>
                                <td>@(suscripcion.Usuario?.Email ?? "-")</td>
                                <td>@suscripcion.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td>@suscripcion.FechaFin.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @(activa ? "bg-success" : "bg-secondary")">
                                        @(activa ? "Activa" : "Caducada/Inactiva")
                                    </span>
                                </td>
                                <td>
                                    @if (factura != null)
                                    {
                                        <a asp-controller="Facturas"
                                           asp-action="Details"
                                           asp-route-id="@factura.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            <i class="bi bi-receipt"></i> @factura.NumeroFactura
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin factura</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-desactivar').forEach(button => {
            button.addEventListener('click', function () {
                const form = this.closest('form');

                Swal.fire({
                    title: '¿Desactivar tipo?',
                    text: 'El tipo dejará de estar disponible para nuevas suscripciones.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ff7a00',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, desactivar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });

        document.querySelectorAll('.btn-activar').forEach(button => {
            button.addEventListener('click', function () {
                const form = this.closest('form');

                Swal.fire({
                    title: '¿Activar tipo?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, activar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}

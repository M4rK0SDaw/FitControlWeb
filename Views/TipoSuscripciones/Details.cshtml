@model FitControlWeb.Models.Entities.TipoSuscripcion

@{
    ViewData["Title"] = "Detalle tipo de suscripción";
    var suscripciones = Model.Suscripcions?
        .OrderByDescending(s => s.FechaInicio)
        .ToList() ?? new List<FitControlWeb.Models.Entities.Suscripcion>();
    var facturasPorSuscripcion = ViewBag.FacturasPorSuscripcion as Dictionary<int, FitControlWeb.Models.Entities.Factura>
        ?? new Dictionary<int, FitControlWeb.Models.Entities.Factura>();
    var hoy = DateTime.Today;
    var activas = suscripciones.Count(s => s.Activa == true && s.FechaFin >= hoy);
    var inactivas = suscripciones.Count - activas;
}

@section Styles {
    <link rel="stylesheet" href="~/css/CrudStyle.css" asp-append-version="true" />
}

<div class="page-card">
    <div class="page-header flex-wrap gap-3">
        <div>
            <h2 class="page-title">@Model.Nombre</h2>
            <p class="text-muted mb-0">Información completa del tipo de suscripción</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-orange">
                <i class="bi bi-pencil"></i> Editar
            </a>

            @if (Model.Activo == true)
            {
                <form asp-action="Desactivar"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline form-desactivar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", "TipoSuscripciones")" />

                    <button type="button" class="btn btn-outline-danger btn-desactivar">
                        <i class="bi bi-x-circle"></i> Desactivar
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Activar"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline form-activar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                    <button type="button" class="btn btn-outline-success btn-activar">
                        <i class="bi bi-arrow-clockwise"></i> Activar
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="info-box">
        <h5 class="fw-bold mb-3">Datos</h5>

        <div class="row g-3">
            <div class="col-md-3">
                <span class="info-label">Nombre</span>
                <p class="info-value">@Model.Nombre</p>
            </div>

            <div class="col-md-3">
                <span class="info-label">Precio</span>
                <p class="info-value">@Model.Precio.ToString("0.00") €</p>
            </div>

            <div class="col-md-3">
                <span class="info-label">Duración</span>
                <p class="info-value">@Model.DuracionDias días</p>
            </div>

            <div class="col-md-3">
                <span class="info-label">Estado</span>
                <br />
                <span class="badge @(Model.Activo == true ? "bg-success" : "bg-danger")">
                    @(Model.Activo == true ? "Activo" : "Inactivo")
                </span>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-4">
        <div class="col-md-4">
            <div class="info-box">
                <span class="info-label">Total suscripciones</span>
                <p class="info-value mb-0">@suscripciones.Count</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box">
                <span class="info-label">Activas</span>
                <p class="info-value mb-0">@activas</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box">
                <span class="info-label">Caducadas o inactivas</span>
                <p class="info-value mb-0">@inactivas</p>
            </div>
        </div>
    </div>

    <div class="info-box mt-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <h5 class="fw-bold mb-1">Usuarios suscritos</h5>
                <p class="text-muted small mb-0">Filtra por usuario, email, fechas, estado o factura.</p>
            </div>

            <span class="badge bg-light text-dark border">Mostrando hasta 25 filas visibles</span>
        </div>

        @if (!suscripciones.Any())
        {
            <div class="alert alert-info mb-0">
                No hay usuarios suscritos a este tipo de suscripción.
            </div>
        }
        else
        {
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <input type="search"
                           class="form-control"
                           id="suscripcionesFiltroGlobal"
                           placeholder="Buscar en todos los campos..." />
                </div>
                <div class="col-md-2">
                    <input type="search" class="form-control suscripciones-column-filter" data-column="usuario" placeholder="Usuario" />
                </div>
                <div class="col-md-2">
                    <input type="search" class="form-control suscripciones-column-filter" data-column="email" placeholder="Email" />
                </div>
                <div class="col-md-2">
                    <input type="search" class="form-control suscripciones-column-filter" data-column="estado" placeholder="Estado" />
                </div>
                <div class="col-md-2">
                    <input type="search" class="form-control suscripciones-column-filter" data-column="factura" placeholder="Factura" />
                </div>
            </div>

            <div class="table-responsive details-table-scroll">
                <table class="table table-hover table-modern align-middle mb-0" id="suscripcionesTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Usuario</th>
                            <th>Email</th>
                            <th>Fecha inicio</th>
                            <th>Fecha fin</th>
                            <th>Estado</th>
                            <th>Factura</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var suscripcion in suscripciones)
                        {
                            var activa = suscripcion.Activa == true && suscripcion.FechaFin >= hoy;
                            facturasPorSuscripcion.TryGetValue(suscripcion.Id, out var factura);
                            var usuarioTexto = suscripcion.Usuario != null
                                ? $"{suscripcion.Usuario.Nombre} {suscripcion.Usuario.Apellidos}"
                                : "Sin usuario";
                            var emailTexto = suscripcion.Usuario?.Email ?? "-";
                            var inicioTexto = suscripcion.FechaInicio.ToString("dd/MM/yyyy");
                            var finTexto = suscripcion.FechaFin.ToString("dd/MM/yyyy");
                            var estadoTexto = activa ? "Activa" : "Caducada/Inactiva";
                            var facturaTexto = factura?.NumeroFactura ?? "Sin factura";

                            <tr data-usuario="@usuarioTexto"
                                data-email="@emailTexto"
                                data-inicio="@inicioTexto"
                                data-fin="@finTexto"
                                data-estado="@estadoTexto"
                                data-factura="@facturaTexto">
                                <td>
                                    @if (suscripcion.Usuario != null)
                                    {
                                        <a asp-controller="Usuarios"
                                           asp-action="Details"
                                           asp-route-id="@suscripcion.Usuario.Id"
                                           class="fw-semibold">
                                            @usuarioTexto
                                        </a>
                                    }
                                    else
                                    {
                                        <span>Sin usuario</span>
                                    }
                                </td>
                                <td>@emailTexto</td>
                                <td>@inicioTexto</td>
                                <td>@finTexto</td>
                                <td>
                                    <span class="badge @(activa ? "bg-success" : "bg-secondary")">
                                        @estadoTexto
                                    </span>
                                </td>
                                <td>
                                    @if (factura != null)
                                    {
                                        <a asp-controller="Facturas"
                                           asp-action="Details"
                                           asp-route-id="@factura.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            <i class="bi bi-receipt"></i> @factura.NumeroFactura
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin factura</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="suscripcionesSinResultados" class="alert alert-info mt-3 mb-0 d-none">
                No hay suscripciones que coincidan con los filtros aplicados.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function normalizarTexto(value) {
            return (value || '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        }

        function filtrarSuscripciones() {
            const global = normalizarTexto(document.getElementById('suscripcionesFiltroGlobal')?.value);
            const filters = Array.from(document.querySelectorAll('.suscripciones-column-filter'))
                .map(input => ({ column: input.dataset.column, value: normalizarTexto(input.value) }))
                .filter(filter => filter.value.length > 0);

            let visibles = 0;

            document.querySelectorAll('#suscripcionesTable tbody tr').forEach(row => {
                const datasetText = normalizarTexto(Object.values(row.dataset).join(' '));
                const matchGlobal = !global || datasetText.includes(global);
                const matchColumns = filters.every(filter => normalizarTexto(row.dataset[filter.column]).includes(filter.value));
                const visible = matchGlobal && matchColumns;

                row.classList.toggle('d-none', !visible);
                if (visible) visibles++;
            });

            document.getElementById('suscripcionesSinResultados')?.classList.toggle('d-none', visibles > 0);
        }

        document.getElementById('suscripcionesFiltroGlobal')?.addEventListener('input', filtrarSuscripciones);
        document.querySelectorAll('.suscripciones-column-filter').forEach(input => input.addEventListener('input', filtrarSuscripciones));

        document.querySelectorAll('.btn-desactivar').forEach(button => {
            button.addEventListener('click', function () {
                const form = this.closest('form');

                Swal.fire({
                    title: '¿Desactivar tipo?',
                    text: 'El tipo dejará de estar disponible para nuevas suscripciones.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ff7a00',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, desactivar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });

        document.querySelectorAll('.btn-activar').forEach(button => {
            button.addEventListener('click', function () {
                const form = this.closest('form');

                Swal.fire({
                    title: '¿Activar tipo?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, activar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}

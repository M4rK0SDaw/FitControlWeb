@model FitControlWeb.Models.Entities.MetodoPago

@{
    ViewData["Title"] = "Detalle método de pago";

    var pagos = Model.Pagos?
        .OrderByDescending(p => p.FechaPago)
        .ToList() ?? new List<FitControlWeb.Models.Entities.Pago>();
    int totalPagos = pagos.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/CrudStyle.css" asp-append-version="true" />
}

<div class="page-card">
    <div class="page-header flex-wrap gap-3">
        <div>
            <h2 class="page-title">@Model.Nombre</h2>
            <p class="text-muted mb-0">Información del método de pago</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>

            <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-orange">
                <i class="bi bi-pencil"></i> Editar
            </a>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline form-delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "MetodoPagos")" />

                <button type="button" class="btn btn-outline-danger btn-delete">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="info-box h-100">
                <h5 class="fw-bold mb-3">Datos</h5>

                <div class="mb-3">
                    <span class="info-label">Nombre</span>
                    <p class="info-value">@Model.Nombre</p>
                </div>

                <div class="mb-3">
                    <span class="info-label">Pagos asociados</span>
                    <p class="info-value">@totalPagos</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="info-box h-100">
                <h5 class="fw-bold mb-3">Aviso</h5>

                <p class="text-muted mb-0">
                    Este método solo se puede eliminar si no tiene pagos asociados.
                    Si ya fue usado en pagos, se mantendrá para conservar el historial.
                </p>
            </div>
        </div>
    </div>

    <div class="info-box mt-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <h5 class="fw-bold mb-1">Pagos y facturas asociadas</h5>
                <p class="text-muted small mb-0">Filtra por ID, factura, cliente, fecha, importe, referencia o estado.</p>
            </div>

            <span class="badge bg-light text-dark border">Mostrando hasta 25 filas visibles</span>
        </div>

        @if (!pagos.Any())
        {
            <div class="alert alert-info mb-0">
                Este método de pago todavía no tiene pagos asociados.
            </div>
        }
        else
        {
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <input type="search"
                           class="form-control"
                           id="pagosFiltroGlobal"
                           placeholder="Buscar en todos los campos..." />
                </div>
                <div class="col-md-2">
                    <input type="search" class="form-control pagos-column-filter" data-column="id" placeholder="ID pago" />
                </div>
                <div class="col-md-2">
                    <input type="search" class="form-control pagos-column-filter" data-column="factura" placeholder="Factura" />
                </div>
                <div class="col-md-2">
                    <input type="search" class="form-control pagos-column-filter" data-column="cliente" placeholder="Cliente" />
                </div>
                <div class="col-md-2">
                    <input type="search" class="form-control pagos-column-filter" data-column="importe" placeholder="Importe" />
                </div>
            </div>

            <div class="table-responsive details-table-scroll">
                <table class="table table-hover table-modern align-middle mb-0" id="pagosTable">
                    <thead class="table-dark">
                        <tr>
                            <th>ID pago</th>
                            <th>Factura</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Importe</th>
                            <th>Referencia</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pago in pagos)
                        {
                            var clienteTexto = pago.Factura?.Usuario != null
                                        ? $"{pago.Factura.Usuario.Nombre} {pago.Factura.Usuario.Apellidos}"
                                        : "Sin cliente";
                            var emailTexto = pago.Factura?.Usuario?.Email ?? string.Empty;
                            var fechaTexto = pago.FechaPago?.ToString("dd/MM/yyyy HH:mm") ?? "-";
                            var importeTexto = pago.Monto.ToString("0.00");
                            var referenciaTexto = string.IsNullOrWhiteSpace(pago.ReferenciaExterna) ? "-" : pago.ReferenciaExterna;
                            var estadoTexto = pago.Activo == true ? "Activo" : "Inactivo";

                            <tr data-id="@pago.Id"
                                data-factura="@(pago.Factura?.NumeroFactura ?? "")"
                                data-cliente="@($"{clienteTexto} {emailTexto}")"
                                data-fecha="@fechaTexto"
                                data-importe="@importeTexto"
                                data-referencia="@referenciaTexto"
                                data-estado="@estadoTexto">
                                <td class="fw-semibold">#@pago.Id</td>
                                <td>@(pago.Factura?.NumeroFactura ?? "-")</td>
                                <td>
                                    @clienteTexto
                                    <br />
                                    <small class="text-muted">@emailTexto</small>
                                </td>
                                <td>@fechaTexto</td>
                                <td class="fw-bold">@pago.Monto.ToString("0.00") EUR</td>
                                <td class="text-break">@referenciaTexto</td>
                                <td>
                                    <span class="badge @(pago.Activo == true ? "bg-success" : "bg-secondary")">
                                        @estadoTexto
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (pago.Factura != null)
                                    {
                                        <a asp-controller="Facturas"
                                           asp-action="Details"
                                           asp-route-id="@pago.Factura.Id"
                                           class="btn btn-sm btn-outline-dark"
                                           title="Ver factura">
                                            <i class="bi bi-receipt"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="pagosSinResultados" class="alert alert-info mt-3 mb-0 d-none">
                No hay pagos que coincidan con los filtros aplicados.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function normalizarTexto(value) {
            return (value || '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        }

        function filtrarPagos() {
            const global = normalizarTexto(document.getElementById('pagosFiltroGlobal')?.value);
            const filters = Array.from(document.querySelectorAll('.pagos-column-filter'))
                .map(input => ({ column: input.dataset.column, value: normalizarTexto(input.value) }))
                .filter(filter => filter.value.length > 0);

            let visibles = 0;

            document.querySelectorAll('#pagosTable tbody tr').forEach(row => {
                const datasetText = normalizarTexto(Object.values(row.dataset).join(' '));
                const matchGlobal = !global || datasetText.includes(global);
                const matchColumns = filters.every(filter => normalizarTexto(row.dataset[filter.column]).includes(filter.value));
                const visible = matchGlobal && matchColumns;

                row.classList.toggle('d-none', !visible);
                if (visible) visibles++;
            });

            document.getElementById('pagosSinResultados')?.classList.toggle('d-none', visibles > 0);
        }

        document.getElementById('pagosFiltroGlobal')?.addEventListener('input', filtrarPagos);
        document.querySelectorAll('.pagos-column-filter').forEach(input => input.addEventListener('input', filtrarPagos));

        document.querySelectorAll('.btn-delete').forEach(button => {
            button.addEventListener('click', function () {
                const form = this.closest('form');

                Swal.fire({
                    title: '¿Eliminar método de pago?',
                    text: 'Solo se eliminará si no tiene pagos asociados.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ff7a00',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}

@model IEnumerable<FitControlWeb.Models.Entities.Reserva>

@{
    ViewData["Title"] = "Mis reservas";
    var vista = (ViewBag.Vista as string) ?? "proximas";
    var ahora = DateTime.Now;
    var hoy = DateOnly.FromDateTime(ahora);
    var horaActual = TimeOnly.FromDateTime(ahora);
}

@section Styles {
    <link rel="stylesheet" href="~/css/CrudStyle.css" asp-append-version="true" />
}

<div class="page-card">
    <div class="page-header">
        <div>
            <h2 class="page-title">Mis reservas</h2>
            <p class="text-muted mb-0">Consulta tus próximas clases o revisa tu historial.</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <div class="btn-group">
                <a asp-action="MisReservas"
                   asp-route-vista="proximas"
                   class="btn @(vista == "proximas" ? "btn-orange" : "btn-outline-secondary")">
                    Próximas
                </a>
                <a asp-action="MisReservas"
                   asp-route-vista="historial"
                   class="btn @(vista == "historial" ? "btn-orange" : "btn-outline-secondary")">
                    Historial
                </a>
            </div>

            <a asp-controller="Clases" asp-action="Index" class="btn btn-orange">Reservar nueva clase</a>
        </div>
    </div>

   @*  @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    } *@

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @(vista == "historial"
                ? "Todavía no tienes reservas finalizadas en el historial."
                : "Todavía no tienes próximas reservas. Puedes reservar una clase desde el listado de clases disponibles.")
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in Model)
            {
                var claseFinalizada = r.Clase.Fecha < hoy || (r.Clase.Fecha == hoy && r.Clase.HoraFin <= horaActual);
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 reserva-card">
                        <div class="card-body">
                            <div class="d-flex gap-2 flex-wrap mb-3">
                                <span class="badge bg-warning text-dark">
                                    @r.EstadoReserva.Nombre
                                </span>

                                @if (claseFinalizada)
                                {
                                    <span class="badge bg-secondary">Finalizada</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Próxima</span>
                                }
                            </div>

                            <h4 class="fw-bold">@r.Clase.Nombre</h4>

                            <p class="text-muted mb-1">
                                Fecha clase: @r.Clase.Fecha.ToString("dd/MM/yyyy")
                            </p>

                            <p class="mb-1">
                                Horario: @r.Clase.HoraInicio - @r.Clase.HoraFin
                            </p>

                            <p class="mb-3">
                                Reserva realizada:
                                @r.FechaReserva?.ToString("dd/MM/yyyy HH:mm")
                            </p>

                            <div class="d-flex gap-2 mb-3">
                                <a asp-controller="Clases"
                                   asp-action="Details"
                                   asp-route-id="@r.ClaseId"
                                   class="btn btn-sm btn-outline-dark">
                                    <i class="bi bi-eye"></i> Ver clase
                                </a>

                                <a asp-controller="EntrenadorDashboard"
                                   asp-action="Publico"
                                   asp-route-id="@r.Clase.EntrenadorId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-person-badge"></i> Monitor
                                </a>
                            </div>

                            @if (!claseFinalizada)
                            {
                                <form asp-action="Cancelar" asp-route-id="@r.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-outline-danger w-100">
                                        Cancelar reserva
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

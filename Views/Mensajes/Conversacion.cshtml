@model FitControlWeb.Models.Entities.Conversacion

@{
    ViewData["Title"] = "Conversación";

    int usuarioActualId = ViewBag.UsuarioActualId;
    var otroUsuario = ViewBag.OtroUsuario as FitControlWeb.Models.Entities.Usuario;
}

@section Styles {
    <link rel="stylesheet" href="~/css/CrudStyle.css" asp-append-version="true" />

    <style>
        .conversation-card {
            min-height: calc(100vh - 170px);
            display: flex;
            flex-direction: column;
        }

        .chat-box {
            height: clamp(360px, 56vh, 560px);
            min-height: 360px;
            max-height: 560px;
            overflow-y: auto;
            padding: 1rem;
            background:
                linear-gradient(180deg, rgba(255,255,255,.94), rgba(255,255,255,.98)),
                color-mix(in srgb, var(--gym-orange, #ff7a00) 8%, #f8fafc);
            border-radius: 16px;
            border: 1px solid color-mix(in srgb, var(--gym-orange, #ff7a00) 18%, #e5e7eb);
            scrollbar-color: var(--gym-orange, #ff7a00) #edf2f7;
        }

        .chat-message {
            max-width: 75%;
            padding: .75rem 1rem;
            border-radius: 16px;
            margin-bottom: .75rem;
            overflow-wrap: anywhere;
        }

            .chat-message.mine {
                margin-left: auto;
                background: var(--gym-orange, #ff7a00);
                color: white;
                box-shadow: 0 12px 24px color-mix(in srgb, var(--gym-orange, #ff7a00) 28%, transparent);
            }

            .chat-message.other {
                margin-right: auto;
                background: white;
                border: 1px solid color-mix(in srgb, var(--gym-orange, #ff7a00) 14%, #dee2e6);
            }

        .chat-time {
            font-size: .75rem;
            opacity: .75;
        }

        .chat-compose textarea {
            height: 68px;
            min-height: 68px;
            max-height: 68px;
            resize: none;
            overflow-y: auto;
            border-color: #d9e1ec;
        }

            .chat-compose textarea:focus {
                border-color: var(--gym-orange, #ff7a00);
                box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--gym-orange, #ff7a00) 20%, transparent);
            }

        .chat-compose .btn-orange {
            min-height: 68px;
        }

        body.dark-mode .chat-box {
            background:
                linear-gradient(180deg, rgba(255,255,255,.94), rgba(255,255,255,.98)),
                color-mix(in srgb, var(--gym-orange, #ff7a00) 8%, #f8fafc);
            color: #111827;
        }

        body.dark-mode .chat-message.other {
            color: #111827;
        }
    </style>
}

<div class="page-card conversation-card">

    <div class="page-header flex-wrap gap-3">
        <div>
            <h2 class="page-title">Conversación</h2>
            <p class="text-muted mb-0">
                Con @otroUsuario?.Nombre @otroUsuario?.Apellidos
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="chat-box mb-4" id="chatBox">
        @if (!Model.Mensajes.Any())
        {
            <div class="alert alert-info mb-0">
                No hay mensajes todavía. Escribe el primero.
            </div>
        }
        else
        {
            foreach (var m in Model.Mensajes.OrderBy(m => m.FechaEnvio))
            {
                <partial name="_MensajeBurbuja" model="m" />
            }
        }
    </div>

    <form asp-action="Enviar" method="post" id="conversationForm" class="chat-compose">
        @Html.AntiForgeryToken()

        <input type="hidden" name="conversacionId" value="@Model.Id" />

        <div class="row g-2">
            <div class="col-md-10">
                <textarea name="contenido"
                          class="form-control"
                          rows="3"
                          maxlength="1000"
                          required
                          placeholder="Escribe tu mensaje..."></textarea>
            </div>

            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-orange">
                    <i class="bi bi-send"></i> Enviar
                </button>
            </div>
        </div>
    </form>

</div>

@section Scripts {
    <script>
        const chatBox = document.getElementById('chatBox');
        const form = document.getElementById('conversationForm');
        const otroUsuarioId = '@(otroUsuario?.Id.ToString() ?? "")';
        const conversacionId = '@Model.Id';

        if (chatBox) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function appendMessage(message) {
            if (!chatBox || !message) return;

            const emptyAlert = chatBox.querySelector('.alert');
            if (emptyAlert) {
                emptyAlert.remove();
            }

            const wrapper = document.createElement('div');
            wrapper.className = `chat-message ${message.esMio ? 'mine' : 'other'}`;

            const author = document.createElement('div');
            author.className = 'fw-semibold small mb-1';
            author.textContent = message.esMio ? 'Tú' : (message.remitenteNombre || 'Usuario');

            const content = document.createElement('div');
            content.textContent = message.contenido || '';

            const time = document.createElement('div');
            time.className = 'chat-time mt-1';
            time.textContent = message.fechaTexto || '';

            wrapper.append(author, content, time);
            chatBox.appendChild(wrapper);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        if (form) {
            form.addEventListener('submit', async (event) => {
                event.preventDefault();

                const formData = new FormData(form);
                const contenido = (formData.get('contenido') || '').toString().trim();
                const submitButton = form.querySelector('button[type="submit"]');

                if (!contenido) return;

                submitButton?.setAttribute('disabled', 'disabled');

                try {
                    const response = await fetch('@Url.Action("EnviarAjax", "Mensajes")', {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!response.ok) {
                        form.submit();
                        return;
                    }

                    const data = await response.json();
                    if (data?.success && data.message) {
                        appendMessage(data.message);
                        form.reset();
                    }
                } catch {
                    form.submit();
                } finally {
                    submitButton?.removeAttribute('disabled');
                }
            });
        }

        if (window.signalR) {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            connection.on('chat:new-message', (payload) => {
                if (!payload || !payload.remitenteId) return;
                if (payload.conversacionId?.toString() === conversacionId && otroUsuarioId && payload.remitenteId.toString() === otroUsuarioId) {
                    appendMessage({
                        esMio: false,
                        contenido: payload.contenido,
                        fechaTexto: payload.fechaTexto,
                        remitenteNombre: payload.remitenteNombre
                    });
                }
            });

            connection.start().catch(() => {
                // Si falla realtime, la conversacion sigue funcionando con envio normal.
            });

        }
    </script>
}
